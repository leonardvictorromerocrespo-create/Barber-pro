{
  "name": "barber-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -File scripts/start-local.ps1",
    "dev:local:server": "node --use-system-ca scripts/serve-real-auth.mjs",
    "build:local": "vite build --mode localtest --outDir dist/local-app",
    "test:local": "node --test tests/local-client.test.mjs tests/local-http.test.mjs",
    "test:screens": "node --test tests/meryo-api.test.mjs tests/local-client.test.mjs tests/local-http.test.mjs tests/screens-render.test.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/operations.test.mjs tests/catalog.test.mjs tests/server.test.mjs",
    "test:incremental": "node --test tests/incremental.test.mjs",
    "test:db": "node --test tests/database.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.2",
    "google-auth-library": "11.3.1",
    "leaflet": "1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.0"
  }
}
